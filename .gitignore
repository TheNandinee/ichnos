# Drive packaging (local only)
drive_export/
scripts/drive_pack.py
scripts/screenshots.py

# Web
web/node_modules/
web/dist/
web/.env
web/.env.*
web/src/*.bak
.vercel/

# Secrets and local env
.env
.env.*
*.key

# OS / editor
.DS_Store
.idea/
.vscode/
*.log
