# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Data (large or regenerated; keep only folder placeholders and the manifest)
data/raw/*
data/parquet/*
data/derived/*
!data/**/.gitkeep
*.tar
*.part
